            "mcp"
          ],
          "cwd": "@DATA@/workspace",
          "env": {
            "PYTHONIOENCODING": "utf-8",
            "PYTHONPATH": "@APP@/legacy/src",
            "QX_LEGACY_ROOT": "@APP@/legacy"
          },
          "toolCallTimeoutMs": 120000
        },
        "disabled": false
      },
      {
        "id": "qx-windows",
        "name": "@APP@/plugins/lazy-mcp/index.mjs",
        "config": {
          "transport": "stdio",
          "serverName": "windows",
          "command": "@APP@/runtime/windows/python.exe",
          "args": [
            "@APP@/python-tool.py",
            "windows",
            "serve",
            "--transport",
            "stdio"
          ],
          "cwd": "@DATA@/workspace",
          "env": {
            "PYTHONIOENCODING": "utf-8",
            "PYTHONPATH": "@APP@/legacy/src",
            "QX_LEGACY_ROOT": "@APP@/legacy"
          },
          "toolCallTimeoutMs": 120000
        },
        "disabled": false
      }
    ]
