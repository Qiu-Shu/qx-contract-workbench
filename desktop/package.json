{
  "name": "qunxing-workbench-desktop",
  "version": "0.4.1",
  "private": true,
  "description": "群兴法律工作台 Windows 本机验证版",
  "author": "群兴法律工作台项目",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "pack": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.qunxing.workbench.validation",
    "productName": "群兴法律工作台验证版",
    "asar": true,
    "electronLanguages": ["zh-CN", "zh-TW", "en-US"],
    "electronDist": "node_modules/electron/dist",
    "directories": {"output": "../dist/desktop"},
    "files": ["main.cjs", "backend.cjs", "model-control.cjs", "profile-basis.cjs", "profile-approval.cjs", "maintenance.cjs", "model-credentials.cjs", "model-settings.cjs", "model-session.cjs", "model-approval.cjs", "model-approval-window.cjs", "model-approval-preload.cjs", "model-approval.html", "model-approval.css", "model-approval.js", "policy.cjs", "preload.cjs", "setup.html", "setup.css", "setup.js", "setup-model.js", "package.json"],
    "extraResources": [{"from": "../dist/qx-backend", "to": "backend"}],
    "win": {"target": "nsis", "signAndEditExecutable": false, "artifactName": "Qunxing-Workbench-${version}-Setup.${ext}"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false, "runAfterFinish": false, "createDesktopShortcut": false, "createStartMenuShortcut": true}
  }
}
